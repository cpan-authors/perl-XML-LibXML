requires 'Alien::Libxml2', '0.14';

requires 'XML::NamespaceSupport', '1.07';
requires 'XML::SAX', '0.11';
requires 'XML::SAX::Base';

# Optional test-time modules. Without these, several t/*.t scripts skip:
#   Test::LeakTrace    -> t/48_memleak_rt_83744.t, t/48_RH5_double_free_rt83779.t,
#                         t/48_memleak_memory_leaks_branch.t
#   URI (>= 1.35)      -> t/49callbacks_returning_undef.t (uses URI::file)
#   Test::Differences  -> t/lib/TestHelpers.pm (better eq_or_diff output)
on 'test' => sub {
    requires 'Test::Differences';
    requires 'Test::LeakTrace';
    requires 'URI', '1.35';
};

# author / release testing
on 'develop' => sub {
    requires 'Test::CPAN::Changes';
    requires 'Test::Kwalitee';
    requires 'Test::Pod';
    requires 'Test::TrailingSpace';
};
